{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "passed": {
      "type": "boolean"
    },
    "checks": {
      "maxItems": 250,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "violations": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    }
  },
  "required": [
    "passed",
    "checks",
    "violations"
  ],
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "constraintId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": [
            "satisfied",
            "violated",
            "uncertain"
          ]
        },
        "outputPointers": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "constraintId",
        "status",
        "outputPointers",
        "explanation"
      ]
    },
    "__schema1": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^\\/.*"
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  }
}
