{
  "name": "character-taste-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:staging": "tsc --noEmit && CLOUDFLARE_ENV=staging vite build",
    "build:production": "tsc --noEmit && CLOUDFLARE_ENV=production vite build",
    "deploy": "npm run deploy:production",
    "deploy:staging": "npm run build:staging && wrangler deploy --env staging --config wrangler.jsonc",
    "deploy:production": "npm run build:production && wrangler deploy --env production --config wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply character-taste-lab --local",
    "db:migrate:remote": "npm run db:migrate:production",
    "db:migrate:staging": "wrangler d1 migrations apply character-taste-lab-staging --remote --env staging --config wrangler.jsonc",
    "db:migrate:production": "wrangler d1 migrations apply character-taste-lab --remote --env production --config wrangler.jsonc",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval": "node eval/run.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "latest",
    "@tanstack/react-query": "latest",
    "hono": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@cloudflare/vite-plugin": "latest",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "jsdom": "^27.0.0",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
