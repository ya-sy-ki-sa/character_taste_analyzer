# このファイルを .dev.vars にコピーし、値を設定してください。.dev.vars はコミットしないでください。
#
# Providerの選択、モデル名、quotaなどの基準設定は wrangler.jsonc にまとめています。
# このファイルでは、ローカル実行で必要な秘密値と、Provider・モデルの上書き設定を管理します。

# -----------------------------------------------------------------------------
# 共通の認証・運用
#
# AUTH_PEPPER: 認証情報などのハッシュ計算に使う32バイト以上のランダムな秘密値。
# TURNSTILE_SECRET: 登録・ログイン時のボット対策。本番では必須、ローカルでは空欄可。
# -----------------------------------------------------------------------------
AUTH_PEPPER=replace-with-at-least-32-random-bytes
TURNSTILE_SECRET=

# -----------------------------------------------------------------------------
# Jev: Cloudflare Workers AI binding経由の意味判定
#
# JEV_PROVIDER: 判断Providerの選択。typesafeでCloudflareのThird-party modelを使う。
# JEV_MODEL: Cloudflare AIのモデルID。現在はtypesafe/jevに固定。
# -----------------------------------------------------------------------------
JEV_PROVIDER=typesafe
JEV_MODEL=typesafe/jev

# -----------------------------------------------------------------------------
# LLM: ルーティング・推論設定
#
# OPENAI_FLEX_ENABLED: OpenAIのFlex Processingを使う場合はtrue。
# LLM_TIER_ROUTES_JSON: defaultとティア別（basic / silver / gold / premium）のprovider、model、effort。
#   ティアに該当する設定がなければdefaultを使い、defaultもなければwrangler.jsoncの共通設定を使う。
#   LLM_PROVIDERがreplay/fakeの場合は、テスト用の共通設定を優先する。
#   effortを省略したルートは、選択したモデルの既定値を使う。
#   例: {"premium":{"provider":"openai","model":"gpt-5.6-luna","effort":"high"}}
# -----------------------------------------------------------------------------
OPENAI_FLEX_ENABLED=false
LLM_TIER_ROUTES_JSON={"default":{"provider":"openai","model":"gpt-5.6-luna"}}

# -----------------------------------------------------------------------------
# Embedding: 嗜好ベクトル生成
#
# EMBEDDING_PROVIDER: embeddingの接続先。通常はopenai、外部APIを使わない試験ではfake。
# EMBEDDING_MODEL: 利用するembeddingモデル。OpenAIの既定値はtext-embedding-3-small。
# EMBEDDING_DIMENSIONS: モデルの出力次元。モデルに合わせて変更する。
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# OpenAI / Cloudflare AI Gateway: REST接続
#
# OPENAI_API_KEY: OpenAIのAPIキー。OpenAIへのREST呼出しはAI Gateway経由。
# AI_GATEWAY_ACCOUNT_ID: REST呼出しに使うCloudflareアカウントID。JevはAI binding経由のため不要。
# AI_GATEWAY_GATEWAY_ID: JevのAI bindingとOpenAI系REST呼出しで共通利用するGateway ID。
# AI_GATEWAY_TOKEN: REST呼出し用Cloudflare APIトークン。
#   「アカウント > AI Gateway > 実行（Run）」権限が必要。JevはAI binding経由のため不要。
# -----------------------------------------------------------------------------
OPENAI_API_KEY=replace-with-openai-api-key
AI_GATEWAY_ACCOUNT_ID=replace-with-cloudflare-account-id
AI_GATEWAY_GATEWAY_ID=default
AI_GATEWAY_TOKEN=replace-with-cloudflare-ai-gateway-token

# -----------------------------------------------------------------------------
# Moderation: 入力内容の事前チェック
#
# MODERATION_PROVIDER: 通常はopenai。外部APIを使わない試験ではfakeを指定する。
# MODERATION_MODEL: 入力の事前チェックに使うモデル名。
# -----------------------------------------------------------------------------
MODERATION_PROVIDER=openai
MODERATION_MODEL=omni-moderation-latest

# -----------------------------------------------------------------------------
# Offline実行
#
# npm run dev:offlineは専用のoffline環境を選び、Replay/Fakeで動くため、
# 上記の外部AI関連値は使用しない。
# -----------------------------------------------------------------------------
