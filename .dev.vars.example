# このファイルを .dev.vars にコピーし、値を設定してください。.dev.vars はコミットしないでください。

# 認証情報などのハッシュ計算に使う秘密値。32バイト以上のランダムな値を設定してください。
AUTH_PEPPER=replace-with-at-least-32-random-bytes

# データ保存方式。現在は Cloudflare D1 を使う d1 に対応しています。
DATASTORE_STRATEGY=d1

# OpenAI の API キー。OpenAI API は常に Cloudflare AI Gateway 経由で呼び出します。
OPENAI_API_KEY=replace-with-openai-api-key

# OpenAI の Flex Processing を使う場合は true。false の場合は処理方式を指定しません。
OPENAI_FLEX_ENABLED=false

# 共通モデルの推論量。空欄ではAPIに送信せず、モデルの既定値を使用します。
# OpenAIでは none / minimal / low / medium / high / xhigh / max を指定できますが、対応値はモデルによって異なります。
# Workers AIでは @cf/openai/gpt-oss-120b と @cf/openai/gpt-oss-20b の low / medium / high に対応しています。
# noneは明示的な指定であり、空欄とは異なります。Fake / Replayでは推論量を変更しません。
LLM_REASONING_EFFORT=

# フォールバック先の推論量。LLM_FALLBACK_PROVIDER / LLM_FALLBACK_MODEL を設定した場合だけ指定できます。
# 空欄ではフォールバック先モデルの既定値を使用し、共通モデルの推論量は引き継ぎません。
LLM_FALLBACK_REASONING_EFFORT=

# ティア別モデルの任意設定。各ティアに {"provider":"接続先","model":"モデル名","effort":"high"} を指定します。
# ティア名は basic / silver / gold / premium。省略したティアは共通の接続先・モデル・推論量を継承します。
# ティアの接続先を明示してeffortだけ省略した場合は、そのモデルの既定値を使用します。
# 例: {"premium":{"provider":"openai","model":"gpt-5.6-sol","effort":"high"}}
# 推論量を含む割当はジョブ作成時に保存され、設定変更は新規ジョブから反映されます。
LLM_TIER_ROUTES_JSON={}

# 自由記述の入力を事前チェックする接続先。通常は openai、外部 API を使わない試験では fake を指定します。
MODERATION_PROVIDER=openai

# 入力の事前チェックに使うモデル名。
MODERATION_MODEL=omni-moderation-latest

# AI Gateway を作成した Cloudflare アカウントの ID。
AI_GATEWAY_ACCOUNT_ID=replace-with-cloudflare-account-id

# 使用する AI Gateway の ID。
AI_GATEWAY_GATEWAY_ID=default

# 「アカウント > AI Gateway > 実行（Run）」権限を持つ Cloudflare API トークン。
AI_GATEWAY_TOKEN=replace-with-cloudflare-ai-gateway-token

# 登録・ログイン時のボット対策に使う Turnstile のシークレットキー。本番では必須です。
# ローカルでは空欄にできます。
TURNSTILE_SECRET=

# `npm run dev:offline`は専用のoffline環境を選び、Replay/Fakeで動くため、AI関連の値は使用しません。
