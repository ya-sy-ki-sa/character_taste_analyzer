# このファイルを .dev.vars にコピーし、秘密値を設定してください。.dev.vars はコミットしないでください。
# Provider・モデル・quotaの共通設定は wrangler.jsonc が正本です。
# この例はローカル実行用の秘密値と、モジュールごとの上書き設定をまとめています。

# -----------------------------------------------------------------------------
# 共通の認証・ボット対策
#
# AUTH_PEPPER: 認証情報などのハッシュ計算に使う32バイト以上のランダムな秘密値。
# TURNSTILE_SECRET: 本番では必須。ローカルでは空欄にできます。
# -----------------------------------------------------------------------------
AUTH_PEPPER=replace-with-at-least-32-random-bytes
TURNSTILE_SECRET=

# -----------------------------------------------------------------------------
# LLM: 生成・分析とティア別ルーティング
#
# LLM_MODEL: 共通OpenAIモデル。wrangler.jsoncの既定値はgpt-6-luna。
# LLM_REASONING_EFFORT: 空欄ならモデルの既定値。none / low / medium / high / xhigh / maxを指定できます。
# LLM_FALLBACK_REASONING_EFFORT: fallback先だけの推論量。空欄ならfallbackモデルの既定値。
# LLM_TIER_ROUTES_JSON: basic / silver / gold / premiumだけをキーにした任意の上書き。
#   未指定のティアは共通のLLM_MODELなどを継承します。defaultキーはこのブランチでは使用できません。
#   例: {"premium":{"provider":"openai","model":"gpt-6-sol","effort":"high"}}
# OPENAI_FLEX_ENABLED: trueのときだけOpenAIへservice_tier:flexを送ります。
# -----------------------------------------------------------------------------
LLM_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=
LLM_FALLBACK_REASONING_EFFORT=
LLM_TIER_ROUTES_JSON={}
OPENAI_FLEX_ENABLED=false

# -----------------------------------------------------------------------------
# Embedding: 嗜好ベクトル生成
#
# モデルと次元数は必ず一致させてください。ローカル既定値は以下のOpenAI 1536次元です。
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# OpenAI / Cloudflare AI Gateway: API接続
#
# OPENAI_API_KEY: OpenAI APIキー。OpenAIの呼出しはAI Gateway経由です。
# AI_GATEWAY_ACCOUNT_ID / AI_GATEWAY_TOKEN: OpenAI系REST呼出しと、ローカルでJevを有効にした場合に必要です。
# AI_GATEWAY_TOKENには「アカウント > AI Gateway > 実行（Run）」権限が必要です。
# AI_GATEWAY_GATEWAY_ID: OpenAI系RESTとJevで共通利用するGateway ID。
# -----------------------------------------------------------------------------
OPENAI_API_KEY=replace-with-openai-api-key
AI_GATEWAY_ACCOUNT_ID=replace-with-cloudflare-account-id
AI_GATEWAY_GATEWAY_ID=default
AI_GATEWAY_TOKEN=replace-with-cloudflare-ai-gateway-token

# -----------------------------------------------------------------------------
# Moderation: 自由記述の事前チェック
#
# 通常はOpenAI。外部APIを使わない試験ではfakeを指定します。
# -----------------------------------------------------------------------------
MODERATION_PROVIDER=openai
MODERATION_MODEL=omni-moderation-latest

# -----------------------------------------------------------------------------
# Jev: 生成キャラの条件検査だけ
#
# offはJev設定・通信不要。shadowは従来LLMの結果を採用しつつJev判定を記録します。
# guardedは高確信で全条件に合格した場合だけ検査LLMを省きます。
# 実モデルの精度を校正するまで本番ではguardedを有効にしないでください。
# ローカルのtypesafe接続には上記のAI GatewayアカウントID・トークンが必要です。
# -----------------------------------------------------------------------------
GENERATION_JEV_MODE=off
JEV_PROVIDER=typesafe

# -----------------------------------------------------------------------------
# Offline実行
#
# npm run dev:offlineでローカルの.dev.varsにある外部Provider設定を混ぜない場合は、
# .dev.vars.offlineを別途作り、AUTH_PEPPERだけを設定してください。
# E2Eは専用の一時.dev.vars.offlineを自動生成・削除します。
# -----------------------------------------------------------------------------
