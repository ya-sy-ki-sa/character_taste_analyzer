{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://character-taste.local/schemas/graph-projection.schema.json",
  "title": "GraphProjectionPage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectionId",
    "profileGeneration",
    "contentHash",
    "detail",
    "nodes",
    "edges",
    "truncated"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "projectionId": { "$ref": "#/$defs/uuid" },
    "profileGeneration": { "type": "integer", "minimum": 1 },
    "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "detail": { "enum": ["summary", "standard", "expanded"] },
    "nodes": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/edge" }
    },
    "truncated": { "type": "boolean" },
    "truncationReason": { "type": ["string", "null"], "maxLength": 500 }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "unitInterval": { "type": "number", "minimum": 0, "maximum": 1 },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "weight", "attributes"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "type": {
          "enum": [
            "user",
            "work",
            "character_identity",
            "representation",
            "attribute",
            "raw_attribute",
            "response_channel",
            "value_stance",
            "context",
            "profile_pattern"
          ]
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 300 },
        "weight": { "$ref": "#/$defs/unitInterval" },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resourceId": { "type": ["string", "null"], "maxLength": 200 },
            "positiveScore": { "oneOf": [{ "$ref": "#/$defs/unitInterval" }, { "type": "null" }] },
            "negativeScore": { "oneOf": [{ "$ref": "#/$defs/unitInterval" }, { "type": "null" }] },
            "confidence": { "oneOf": [{ "$ref": "#/$defs/unitInterval" }, { "type": "null" }] },
            "classification": { "type": ["string", "null"], "enum": ["stable", "emerging", "insufficient", null] },
            "category": { "type": ["string", "null"], "maxLength": 100 },
            "scope": { "type": ["object", "null"] },
            "flags": {
              "type": "array",
              "maxItems": 30,
              "uniqueItems": true,
              "items": { "type": "string", "maxLength": 100 }
            }
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "type", "directed", "weight", "confidence", "evidenceCount", "attributes"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "source": { "type": "string", "minLength": 1, "maxLength": 200 },
        "target": { "type": "string", "minLength": 1, "maxLength": 200 },
        "type": {
          "enum": [
            "likes",
            "dislikes",
            "has_attribute",
            "in_work",
            "represented_as",
            "responds_via",
            "has_stance",
            "conditioned_by",
            "supports_pattern",
            "related_attribute",
            "derived_from"
          ]
        },
        "directed": { "type": "boolean" },
        "weight": { "$ref": "#/$defs/unitInterval" },
        "confidence": { "$ref": "#/$defs/unitInterval" },
        "evidenceCount": { "type": "integer", "minimum": 0 },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "responseChannel": { "type": ["string", "null"], "maxLength": 100 },
            "stance": { "type": ["string", "null"], "maxLength": 100 },
            "orientation": { "type": ["string", "null"], "maxLength": 100 },
            "conditionHash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
            "explanation": { "type": ["string", "null"], "maxLength": 1000 }
          }
        }
      }
    }
  }
}
