{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://character-taste.local/schemas/preference-analysis.schema.json",
  "title": "PreferenceAnalysisResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "analysisRunId",
    "entryRevisionId",
    "understandingSnapshotId",
    "summary",
    "preferenceAssertions",
    "valueStanceAssertions",
    "uncertainties"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "analysisRunId": { "$ref": "#/$defs/uuid" },
    "entryRevisionId": { "$ref": "#/$defs/uuid" },
    "understandingSnapshotId": { "$ref": "#/$defs/uuid" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userExplicitSummary", "inferredSummary", "limitations"],
      "properties": {
        "userExplicitSummary": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 1000 } },
        "inferredSummary": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 1000 } },
        "limitations": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 1000 } }
      }
    },
    "preferenceAssertions": {
      "type": "array",
      "maxItems": 300,
      "items": { "$ref": "#/$defs/preferenceAssertion" }
    },
    "valueStanceAssertions": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/valueStanceAssertion" }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "reason", "recommendedQuestion"],
        "properties": {
          "topic": { "type": "string", "minLength": 1, "maxLength": 500 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "recommendedQuestion": { "type": ["string", "null"], "maxLength": 1000 }
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "unitInterval": { "type": "number", "minimum": 0, "maximum": 1 },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "const": "1" },
        "workIds": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
        "representationIds": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uuid" }
        },
        "scopeTypes": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 100 }
        },
        "relationshipTargets": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 200 }
        },
        "sceneTags": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 200 }
        },
        "freeText": { "type": "string", "maxLength": 1000 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "origin", "supportType", "confidence"],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sourceFragmentId": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "userInputPath": { "type": ["string", "null"], "maxLength": 500 },
        "origin": { "enum": ["source", "user_input", "review", "model_knowledge", "derived"] },
        "supportType": { "enum": ["supports", "contradicts", "context"] },
        "confidence": { "$ref": "#/$defs/unitInterval" }
      }
    },
    "responseChannel": {
      "enum": [
        "aesthetic_liking",
        "person_liking",
        "admiration",
        "empathy",
        "actual_similarity",
        "wishful_identification",
        "narrative_identification",
        "parasocial_closeness",
        "protectiveness",
        "romantic_attraction",
        "sexual_attraction",
        "curiosity",
        "narrative_interest",
        "moral_support",
        "fascination_with_transgression",
        "root_for",
        "love_to_hate",
        "desire_no_redemption"
      ]
    },
    "preferenceAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "characterIdentityId",
        "representationId",
        "rawLabel",
        "polarity",
        "responseChannel",
        "strength",
        "explicitness",
        "confidence",
        "context",
        "evidence",
        "status"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "characterIdentityId": { "$ref": "#/$defs/uuid" },
        "representationId": { "$ref": "#/$defs/uuid" },
        "attributeStableKey": { "type": ["string", "null"], "pattern": "^[a-z0-9_.-]+$", "maxLength": 150 },
        "rawLabel": { "type": "string", "minLength": 1, "maxLength": 200 },
        "polarity": { "enum": ["positive", "negative", "mixed"] },
        "responseChannel": { "$ref": "#/$defs/responseChannel" },
        "strength": { "$ref": "#/$defs/unitInterval" },
        "explicitness": { "enum": ["user_explicit", "user_confirmed", "inferred", "model_knowledge"] },
        "confidence": { "$ref": "#/$defs/unitInterval" },
        "context": { "$ref": "#/$defs/context" },
        "evidence": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/evidence" } },
        "status": { "enum": ["proposed", "confirmed", "corrected", "rejected", "superseded"] }
      }
    },
    "valueStanceAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "targetType",
        "targetRef",
        "stance",
        "orientation",
        "scope",
        "explicitness",
        "confidence",
        "evidence",
        "status",
        "linkedPreferenceAssertionIds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "targetType": { "enum": ["attribute", "value", "action", "role", "outcome", "expression"] },
        "targetRef": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "stance": { "enum": ["affirm", "accept", "indifferent", "ambivalent", "reject", "unspecified"] },
        "orientation": {
          "enum": ["evil", "immoral", "indifferent_to_good", "transgressive", "self_defined", "good", "mixed"]
        },
        "scope": { "$ref": "#/$defs/context" },
        "explicitness": { "enum": ["user_explicit", "user_confirmed", "inferred"] },
        "confidence": { "$ref": "#/$defs/unitInterval" },
        "evidence": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/evidence" } },
        "status": { "enum": ["proposed", "confirmed", "corrected", "rejected", "superseded"] },
        "linkedPreferenceAssertionIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uuid" }
        }
      }
    }
  }
}
