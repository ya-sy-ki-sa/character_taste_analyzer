{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://character-taste.local/schemas/generated-character.schema.json",
  "title": "GeneratedCharacterRevision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "briefId",
    "identity",
    "appearance",
    "personality",
    "valuesAndMorality",
    "motivations",
    "abilitiesAndLimits",
    "relationships",
    "speech",
    "narrativeRole",
    "characterArc",
    "briefCoverage",
    "uncertainties"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "briefId": { "$ref": "#/$defs/uuid" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "aliases", "oneLineConcept", "origin", "ageExpression", "pronouns"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "aliases": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 200 } },
        "oneLineConcept": { "type": "string", "minLength": 1, "maxLength": 500 },
        "origin": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "ageExpression": { "type": ["string", "null"], "maxLength": 200 },
        "pronouns": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "appearance": { "$ref": "#/$defs/section" },
    "personality": { "$ref": "#/$defs/section" },
    "valuesAndMorality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orientation", "values", "moralRelationship", "redemption", "hiddenGoodness", "consequences"],
      "properties": {
        "orientation": {
          "enum": ["evil", "immoral", "indifferent_to_good", "transgressive", "self_defined", "good", "mixed"]
        },
        "values": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "$ref": "#/$defs/trait" } },
        "moralRelationship": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "redemption": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "hiddenGoodness": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "consequences": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "motivations": { "$ref": "#/$defs/section" },
    "abilitiesAndLimits": { "$ref": "#/$defs/section" },
    "relationships": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetRole", "dynamic", "characterBehavior", "development"],
        "properties": {
          "targetRole": { "type": "string", "minLength": 1, "maxLength": 300 },
          "dynamic": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "characterBehavior": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "development": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "speech": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voice", "habits", "exampleLines"],
      "properties": {
        "voice": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "habits": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 500 } },
        "exampleLines": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 500 } }
      }
    },
    "narrativeRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "function", "agency", "visibility"],
      "properties": {
        "role": { "type": "string", "minLength": 1, "maxLength": 500 },
        "function": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "agency": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "visibility": { "enum": ["central", "supporting", "minor", "scene_limited"] }
      }
    },
    "characterArc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "turningPoints", "end", "changeType"],
      "properties": {
        "start": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "turningPoints": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 1000 } },
        "end": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "changeType": { "enum": ["positive", "negative", "flat", "corruption", "no_redemption", "open", "other"] }
      }
    },
    "briefCoverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profileSnapshotItemId", "treatment", "status", "outputPointers", "explanation"],
        "properties": {
          "profileSnapshotItemId": { "$ref": "#/$defs/uuid" },
          "treatment": { "enum": ["required", "include", "weak_include", "explore", "omit", "prohibit"] },
          "status": { "enum": ["satisfied", "partially_satisfied", "not_applicable", "violated"] },
          "outputPointers": { "type": "array", "maxItems": 30, "items": { "type": "string", "pattern": "^/" } },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "maxLength": 1000 }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "trait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "description", "expressions"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "expressions": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 500 } }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "traits"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "traits": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "$ref": "#/$defs/trait" } }
      }
    }
  }
}
