{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "character-taste-lab-v2",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-03",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "local",
    "DATASTORE_STRATEGY": "d1",
    "LLM_PROVIDER": "openai",
    "LLM_MODEL": "gpt-5.6-luna",
    "LLM_FALLBACK_PROVIDER": "",
    "LLM_FALLBACK_MODEL": "",
    "AI_GATEWAY_GATEWAY_ID": "default",
    "EMBEDDING_PROVIDER": "openai",
    "EMBEDDING_MODEL": "text-embedding-3-small",
    "EMBEDDING_DIMENSIONS": "1536",
    "ANALYSIS_DAILY_QUOTA": "30",
    "GENERATION_DAILY_QUOTA": "10",
    "EXPORT_DAILY_QUOTA": "3",
    "SESSION_DAYS": "30",
    "SESSION_RENEWAL_DAYS": "7",
    "PUBLIC_WRITE_LIMIT_10_MIN": "1000",
    "USER_WRITE_LIMIT_PER_MIN": "1000",
    "IP_WRITE_LIMIT_PER_MIN": "1000",
    "APP_ORIGIN": "http://localhost:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "character-taste-lab-current-local",
      "database_id": "00000000-0000-4000-8000-000000000003",
      "migrations_dir": "docs/詳細設計/database"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EXPORTS",
      "bucket_name": "character-taste-exports-local",
      "remote": false
    }
  ],
  "triggers": {
    "crons": ["* * * * *", "17 3 * * *"]
  },
  "workflows": [
    {
      "name": "character-taste-analysis",
      "binding": "CHARACTER_ANALYSIS_WORKFLOW",
      "class_name": "CharacterAnalysisWorkflow"
    },
    {
      "name": "character-taste-generation",
      "binding": "GENERATION_WORKFLOW",
      "class_name": "GenerationWorkflow"
    },
    {
      "name": "character-taste-profile-rebuild",
      "binding": "PROFILE_REBUILD_WORKFLOW",
      "class_name": "ProfileRebuildWorkflow"
    },
    {
      "name": "character-taste-account-export",
      "binding": "ACCOUNT_EXPORT_WORKFLOW",
      "class_name": "AccountExportWorkflow"
    }
  ],
  "env": {
    "offline": {
      "name": "character-taste-lab-v2-offline",
      "vars": {
        "ENVIRONMENT": "local",
        "DATASTORE_STRATEGY": "d1",
        "LLM_PROVIDER": "replay",
        "LLM_MODEL": "replay-v1",
        "LLM_FALLBACK_PROVIDER": "",
        "LLM_FALLBACK_MODEL": "",
        "EMBEDDING_PROVIDER": "fake",
        "EMBEDDING_MODEL": "fake-v1",
        "EMBEDDING_DIMENSIONS": "1536",
        "ANALYSIS_DAILY_QUOTA": "1000",
        "GENERATION_DAILY_QUOTA": "1000",
        "EXPORT_DAILY_QUOTA": "1000",
        "SESSION_DAYS": "30",
        "SESSION_RENEWAL_DAYS": "7",
        "PUBLIC_WRITE_LIMIT_10_MIN": "1000",
        "USER_WRITE_LIMIT_PER_MIN": "1000",
        "IP_WRITE_LIMIT_PER_MIN": "1000",
        "APP_ORIGIN": "http://localhost:41737"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "character-taste-lab-current-local",
          "database_id": "00000000-0000-4000-8000-000000000003",
          "migrations_dir": "docs/詳細設計/database"
        }
      ],
      "r2_buckets": [
        {
          "binding": "EXPORTS",
          "bucket_name": "character-taste-exports-offline",
          "remote": false
        }
      ],
      "workflows": [
        {
          "name": "character-taste-analysis-offline",
          "binding": "CHARACTER_ANALYSIS_WORKFLOW",
          "class_name": "CharacterAnalysisWorkflow"
        },
        {
          "name": "character-taste-generation-offline",
          "binding": "GENERATION_WORKFLOW",
          "class_name": "GenerationWorkflow"
        },
        {
          "name": "character-taste-profile-rebuild-offline",
          "binding": "PROFILE_REBUILD_WORKFLOW",
          "class_name": "ProfileRebuildWorkflow"
        },
        {
          "name": "character-taste-account-export-offline",
          "binding": "ACCOUNT_EXPORT_WORKFLOW",
          "class_name": "AccountExportWorkflow"
        }
      ]
    },
    "staging": {
      "name": "character-taste-lab-staging",
      "vars": {
        "ENVIRONMENT": "preview",
        "DATASTORE_STRATEGY": "d1",
        "LLM_PROVIDER": "workers_ai",
        "LLM_MODEL": "@cf/openai/gpt-oss-120b",
        "LLM_FALLBACK_PROVIDER": "openai",
        "LLM_FALLBACK_MODEL": "gpt-5.6-sol",
        "AI_GATEWAY_GATEWAY_ID": "default",
        "EMBEDDING_PROVIDER": "workers_ai",
        "EMBEDDING_MODEL": "@cf/baai/bge-m3",
        "EMBEDDING_DIMENSIONS": "1024",
        "ANALYSIS_DAILY_QUOTA": "30",
        "GENERATION_DAILY_QUOTA": "10",
        "EXPORT_DAILY_QUOTA": "3",
        "SESSION_DAYS": "30",
        "SESSION_RENEWAL_DAYS": "7",
        "PUBLIC_WRITE_LIMIT_10_MIN": "30",
        "USER_WRITE_LIMIT_PER_MIN": "60",
        "IP_WRITE_LIMIT_PER_MIN": "120",
        "APP_ORIGIN": "https://character-taste-lab-staging.toshitaka-portfolio-account.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "character-taste-lab-v2-staging",
          "database_id": "f4ef85cc-ca2c-4e97-93c6-bc77cdca65fb",
          "migrations_dir": "docs/詳細設計/database"
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "r2_buckets": [
        {
          "binding": "EXPORTS",
          "bucket_name": "character-taste-exports-staging"
        }
      ],
      "workflows": [
        {
          "name": "character-taste-analysis-staging",
          "binding": "CHARACTER_ANALYSIS_WORKFLOW",
          "class_name": "CharacterAnalysisWorkflow"
        },
        {
          "name": "character-taste-generation-staging",
          "binding": "GENERATION_WORKFLOW",
          "class_name": "GenerationWorkflow"
        },
        {
          "name": "character-taste-profile-rebuild-staging",
          "binding": "PROFILE_REBUILD_WORKFLOW",
          "class_name": "ProfileRebuildWorkflow"
        },
        {
          "name": "character-taste-account-export-staging",
          "binding": "ACCOUNT_EXPORT_WORKFLOW",
          "class_name": "AccountExportWorkflow"
        }
      ]
    },
    "production": {
      "name": "character-taste-analyzer",
      "vars": {
        "ENVIRONMENT": "production",
        "DATASTORE_STRATEGY": "d1",
        "LLM_PROVIDER": "openai",
        "LLM_MODEL": "gpt-5.6-sol",
        "LLM_FALLBACK_PROVIDER": "workers_ai",
        "LLM_FALLBACK_MODEL": "@cf/openai/gpt-oss-120b",
        "AI_GATEWAY_GATEWAY_ID": "default",
        "EMBEDDING_PROVIDER": "openai",
        "EMBEDDING_MODEL": "text-embedding-3-small",
        "EMBEDDING_DIMENSIONS": "1536",
        "ANALYSIS_DAILY_QUOTA": "30",
        "GENERATION_DAILY_QUOTA": "10",
        "EXPORT_DAILY_QUOTA": "3",
        "SESSION_DAYS": "30",
        "SESSION_RENEWAL_DAYS": "7",
        "PUBLIC_WRITE_LIMIT_10_MIN": "30",
        "USER_WRITE_LIMIT_PER_MIN": "60",
        "IP_WRITE_LIMIT_PER_MIN": "120",
        "APP_ORIGIN": "https://character-taste-analyzer.toshitaka-portfolio-account.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "character-taste-lab",
          "database_id": "5e4c10b5-8d80-4f54-90e4-3624470ce482",
          "migrations_dir": "docs/詳細設計/database"
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "r2_buckets": [
        {
          "binding": "EXPORTS",
          "bucket_name": "character-taste-exports-production"
        }
      ],
      "workflows": [
        {
          "name": "character-taste-analysis",
          "binding": "CHARACTER_ANALYSIS_WORKFLOW",
          "class_name": "CharacterAnalysisWorkflow"
        },
        {
          "name": "character-taste-generation",
          "binding": "GENERATION_WORKFLOW",
          "class_name": "GenerationWorkflow"
        },
        {
          "name": "character-taste-profile-rebuild",
          "binding": "PROFILE_REBUILD_WORKFLOW",
          "class_name": "ProfileRebuildWorkflow"
        },
        {
          "name": "character-taste-account-export",
          "binding": "ACCOUNT_EXPORT_WORKFLOW",
          "class_name": "AccountExportWorkflow"
        }
      ]
    }
  }
}
